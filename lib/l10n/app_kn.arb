  "helpFaqReplySymptomChecking": "ಲಕ್ಷಣಗಳನ್ನು ಪರಿಶೀಲಿಸಲು:\n1) ಚಾಟ್ / ಲಕ್ಷಣ ಪರಿಶೀಲಕ ತೆರೆಯಿರಿ\n2) ನಿಮ್ಮ ಲಕ್ಷಣಗಳನ್ನು ಟೈಪ್ ಮಾಡಿ (ಅಥವಾ ಧ್ವನಿ ಬಳಸಿ)\n3) ಮುಂದಿನ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಿಸಿ\n\nMediMitra ಸಾಧ್ಯವಾದ ಕಾರಣಗಳು ಮತ್ತು ಮುಂದಿನ ಹೆಜ್ಜೆಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. ಗಂಭೀರ ಲಕ್ಷಣಗಳು (ಛಾತಿ ನೋವು, ಉಸಿರಾಟ ಕಷ್ಟ, ಮೂರ್ಚೆ) ಇದ್ದರೆ ತಕ್ಷಣ ಚಿಕಿತ್ಸೆ ಪಡೆಯಿರಿ.",
  "helpFaqReplyVoiceSymptoms": "ಧ್ವನಿ ಲಕ್ಷಣಗಳು: ಮೈಕ್ ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ, ನಿಮ್ಮ ಲಕ್ಷಣಗಳನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳಿ; ಆಪ್ ಅದನ್ನು ಪಠ್ಯವಾಗಿ ಪರಿವರ್ತಿಸಿ ವಿಶ್ಲೇಷಿಸುತ್ತದೆ.\n\nಟಿಪ್ಸ್: ಒಂದೊಮ್ಮೆ ಒಂದು ಲಕ್ಷಣ ಹೇಳಿ, ಸರಳ ಪದಗಳನ್ನು ಬಳಸಿ (\"ಜ್ವരം\", \"ಕೆಮ್ಮು\") ಮತ್ತು ಕೇಳಿದಾಗ ಮೈಕ್ರೋಫೋನ್ ಅನುಮತಿ ನೀಡಿ.",
  "helpFaqReplyOutbreakAlert": "ಪ್ರಕೋಪ ಅಲರ್ಟ್ ನಿಮ್ಮ ಪ್ರದೇಶದಲ್ಲಿ ಯಾವ ಲಕ್ಷಣಗಳು ಹೆಚ್ಚಾಗಿ ಕಂಡುಬರುತ್ತಿವೆ ಎಂಬುದನ್ನು ತಿಳಿಯಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಇದು ಅನಾಮಧೇಯ, ಒಟ್ಟುಗೂಡಿಸಿದ ಡೇಟಾದ ಮೇಲೆ ಆಧಾರಿತವಾಗಿದೆ ಮತ್ತು ಅರಿವಿಗಾಗಿ (ರೋಗನಿರ್ಣಯಕ್ಕೆ ಅಲ್ಲ).\n\nOutbreak ವಿಭಾಗದಲ್ಲಿ ಇನ್‌ಸೈಟ್‌ಗಳನ್ನು ನೋಡಬಹುದು.",
  "helpFaqReplyNearbyClinics": "ಹತ್ತಿರದ ಕ್ಲಿನಿಕ್‌ಗಳು: ಕ್ಲಿನಿಕ್ ಲೊಕೇಟರ್ ತೆರೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಸುತ್ತಲಿನ ಕ್ಲಿನಿಕ್‌ಗಳನ್ನು ನೋಡಿ.\n\nಸ್ಥಳ ಅನುಮತಿ ಸಕ್ರಿಯವಾಗಿದೆ ಎಂಬುದು ಖಚಿತಪಡಿಸಿ.",
  "helpFaqReplyOtpLogin": "OTP ಲಾಗಿನ್: ನಿಮ್ಮ 10 ಅಂಕಿಯ ಮೊಬೈಲ್ ಸಂಖ್ಯೆಯನ್ನು ನಮೂದಿಸಿ; ನಾವು ಪರಿಶೀಲನಾ OTP ಕಳುಹಿಸುತ್ತೇವೆ. 6 ಅಂಕಿಯ OTP ನಮೂದಿಸಿ ಮುಂದುವರಿಯಿರಿ.\n\nಬರದಿದ್ದರೆ, ರಿಸೆಂಡ್ ಟೈಮರ್ ನಂತರ ಮರುಪ್ರಯತ್ನಿಸಿ; ನೆಟ್ವರ್ಕ್ ಪರಿಶೀಲಿಸಿ.",
  "helpFaqReplyGuestMode": "ಗೆಸ್ಟ್ ಮೋಡ್‌ನಲ್ಲಿ ಲಾಗಿನ್ ಇಲ್ಲದೆ ಆಪ್ ಬಳಸಬಹುದು. ಆದರೆ ಪ್ರೊಫೈಲ್‌ಗೆ ಸೇವ್ ಆಗುವ ಕೆಲವು ವೈಶಿಷ್ಟ್ಯಗಳು ಮಿತವಾಗಿರಬಹುದು.",
  "helpFaqReplyPrivacy": "ನಿಮ್ಮ ಅನುಭವವನ್ನು ವೈಯಕ್ತೀಕರಿಸಲು (ಹೆಸರು/ವಯಸ್ಸು/ಲಿಂಗ/ಸ್ಥಿತಿಗಳು) ಪ್ರೊಫೈಲ್ ಡೇಟಾವನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಉಳಿಸಲಾಗುತ್ತದೆ. ಚಾಟ್‌ನಲ್ಲಿ ಸಂವೇದನಾಶೀಲ ಮಾಹಿತಿ ಹಂಚಿಕೊಳ್ಳಬೇಡಿ.\n\nವಿವರಗಳಿಗೆ ಆಪ್‌ನ ಗೌಪ್ಯತಾ ನೀತಿಯನ್ನು ನೋಡಿ.",
  "helpFaqReplyChangeLanguage": "ಭಾಷೆ ಬದಲಾಯಿಸಲು: ಪ್ರೊಫೈಲ್ → ಭಾಷೆ.",
  "helpFaqReplyDarkMode": "ಡಾರ್ಕ್ ಮೋಡ್: ಪ್ರೊಫೈಲ್ → ಡಾರ್ಕ್ ಮೋಡ್‌ನಲ್ಲಿ ಟಾಗಲ್ ಮಾಡಿ.",
  "helpFaqReplyContactSupport": "ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಲು: Contact Us ತೆರೆಯಿರಿ ಮತ್ತು ಸಂದೇಶ ಕಳುಹಿಸಿ. ಸಾಧ್ಯವಾದರೆ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಮತ್ತು ಹಂತಗಳನ್ನು ಸೇರಿಸಿ.",
  "helpFaqReplyFallback": "ನಾನು ಸಹಾಯ ಮಾಡುವ ವಿಷಯಗಳು: ಲಕ್ಷಣ ಪರಿಶೀಲನೆ, ಧ್ವನಿ ಇನ್‌ಪುಟ್, ಪ್ರಕೋಪ ಅಲರ್ಟ್‌ಗಳು, ಕ್ಲಿನಿಕ್ ಲೊಕೇಟರ್, OTP ಲಾಗಿನ್, ಗೌಪ್ಯತೆ, ಭಾಷೆ, ಮತ್ತು ಡಾರ್ಕ್ ಮೋಡ್.\n\nಇವುಗಳಲ್ಲಿ ಒಂದನ್ನು ಪ್ರಯತ್ನಿಸಿ: \"ಲಕ್ಷಣಗಳನ್ನು ಹೇಗೆ ಪರಿಶೀಲಿಸಬೇಕು?\", \"ಹತ್ತಿರದ ಕ್ಲಿನಿಕ್‌ಗಳನ್ನು ಹೇಗೆ ಹುಡುಕುವುದು?\", \"ನನ್ನ ಡೇಟಾ ಸುರಕ್ಷಿತವೇ?\""
}
