        "type": "boolean",
        "maps_to": "breathing_difficulty_present"
      },
      {
        "id": "wheezing_present",
        "text": "Do you hear wheezing or whistling sounds when breathing?",
        "type": "boolean",
        "maps_to": "wheezing_present"
      },
      {
        "id": "cough_present",
        "text": "Do you have a cough?",
        "type": "boolean",
        "maps_to": "cough_present"
      },
      {
        "id": "cough_duration",
        "text": "How long have you had the cough?",
        "type": "graded",
        "depends_on": {
          "question": "cough_present",
          "value": true
        },
        "maps_to": "cough_duration",
        "options": {
          "less_than_3_days": 0.4,
          "3_to_7_days": 0.7,
          "more_than_7_days": 1.0
        }
      },
      {
        "id": "chest_pain_exertional",
        "text": "Does the chest pain worsen with physical activity or exertion?",
        "type": "boolean",
        "depends_on": {
          "question": "chest_pain_present",
          "value": true
        },
        "maps_to": "chest_pain_exertional"
      },
      {
        "id": "smoking_frequency",
        "text": "How often do you smoke?",
        "type": "graded",
        "maps_to": "smoking_frequency",
        "options": {
          "never": 0.0,
          "occasionally": 0.3,
          "weekly": 0.5,
          "daily": 0.7,
          "heavy": 1.0
        }
      }
    ]
  },

