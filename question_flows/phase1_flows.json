  "chest": {
    "description": "Questions related to chest pain and breathing issues",
    "questions": [
      {
        "id": "chest_pain_present",
        "text": "Do you feel chest pain or chest tightness?",
        "type": "boolean",
        "maps_to": "chest_pain_present"
      },
      {
        "id": "breathing_difficulty_present",
